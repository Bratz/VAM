{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "meta": {
    "name": "Aperture Design System",
    "version": "2.1.0",
    "description": "Premium-Glass Design Tokens for Aperture — Treasury Intelligence",
    "author": "Aperture Design Team",
    "lastUpdated": "2026-05-13",
    "designPhilosophy": {
      "direction": "Premium-Glass — own the polish, applied with discipline",
      "principles": [
        "Atmospheric depth over flat surfaces (radial ambience, gold lens accents, navy gradient strip)",
        "Typography-led hierarchy with a confident serif display (Fraunces) over a workhorse sans (Bricolage Grotesque) and tabular mono numerics (JetBrains Mono)",
        "Single dominant figure per page (HeroMetricCard) — operational tiles sit below, never compete",
        "Section-tinted ambient hue via --section-accent / --section-accent-warm — orientation without inventing new chrome",
        "Gold as a precious accent — used sparingly for brand moments (page-title underline, hero lens, focus ring), never as a generic highlight",
        "Glass blur reserved for floating surfaces (sidebar, header, modals, drawer) — never on inline content"
      ],
      "rejectedDirections": [
        "Swiss / International Style minimalism — incompatible with the atmospheric layering and gold accents that give Aperture its identity. The earlier 'Swiss' framing in this file was aspirational and contradicted the actual output; v2.1 owns the polish direction honestly."
      ],
      "influences": [
        "Linear's calm density and consistent type rhythm",
        "Stripe's confidence with serif display + clean sans body",
        "Modern private-banking UIs (Goldman Marcus, Coutts, JPM Wealth) — gold accents read as 'premium' to treasurers without crossing into ostentatious"
      ],
      "layoutPrimitives": {
        "_description": "Phase 10 Design System Unification (2026-05-13): shared layout shells. Pages should compose <Page> + <PageHeader> + <StatStrip> instead of hand-rolling max-width / vertical-spacing / grid-column recipes. The app shell (Layout.tsx) supplies horizontal padding (p-4 lg:p-8) and the page-enter animation; the Page primitive must not duplicate those.",
        "Page":       "Standard page wrapper. maxWidth='default' (1280px / max-w-7xl) | 'narrow' (1024px / max-w-5xl) | 'full' (uncapped). Applies space-y-6 vertical rhythm.",
        "PageHeader": "Title (Fraunces 30px via .page-title) + optional description + optional right-aligned actions slot. Use as first child of <Page>. Note: most page CTAs already live in the Aperture Layout header via usePageHeaderActions — only use this slot for in-body actions.",
        "StatStrip":  "Top-of-page metric tile row. Auto-derives column count from child count (1→6); standardizes gap-4. Override via columns={n} when child set is dynamic."
      },
      "typographyUtilities": {
        "_description": "Authoritative list of typography utility classes defined in frontend/src/styles/index.css. Pages should use these instead of raw Tailwind text-* + font-* combinations. Phase 5 Design System Unification.",
        "typefaces": {
          "_description": "Tier 1 audience-fit pass (2026-05-17): swapped the display family from Fraunces (variable serif) to IBM Plex Sans (grotesque) for numeric values. The serif is preserved on page titles only as a brand moment. Body and identifier families unchanged.",
          "title":   "Fraunces — page titles only (`.page-title`, `.page-title-display`, `.section-title`). Weights 500–600.",
          "numeric": "IBM Plex Sans — stat values at all scales. Weights 400–700. Free Google Font designed by IBM, used in IBM Cloud Pak for Data and Watson Treasury.",
          "body":    "Bricolage Grotesque — body, UI labels, form fields. Weights 300–800. May be evaluated for replacement in Tier 3.",
          "mono":    "JetBrains Mono — identifiers (VA numbers, IBANs, BICs, references, transaction IDs) only. Weights 400–500. Not for monetary amounts; Tier 2 introduces a sans-tabular `.amount` utility for those."
        },
        "display": {
          "page-title":            "Page hero heading. Fraunces 30px/500w, gold underline. Use on <h1> inside page body.",
          "section-title":         "Section heading, one notch down from page-title. Fraunces 20px/500w.",
          "stat-value":            "Hero numeric display for HeroMetricCard. IBM Plex Sans 36px/600w, tabular-nums, tight tracking.",
          "stat-value-sm":         "Smaller stat value for secondary tiles. IBM Plex Sans 24px/600w, tabular-nums. Neutral primary-900 text.",
          "stat-value-xs":         "Secondary stat value for dense cards. IBM Plex Sans 20px/600w, tabular-nums.",
          "stat-value-inverse":    "Inverse variant — white text for surfaces that paint dark in both themes (e.g. Treasury Hierarchy bank-account banner). IBM Plex Sans 24px/600w.",
          "stat-value-inverse-lg": "Hero-sized inverse variant for full-bleed dark heroes (e.g. CurrencyMirror consolidated-position banner). IBM Plex Sans 36px/600w.",
          "stat-value-success":    "Tone variant — semantic success-coloured stat value (green). IBM Plex Sans, same typographic treatment as stat-value-sm.",
          "stat-value-warning":    "Tone variant — semantic warning-coloured stat value (warm-orange). IBM Plex Sans.",
          "stat-value-error":      "Tone variant — semantic error-coloured stat value (red). IBM Plex Sans.",
          "stat-value-info":       "Tone variant — semantic info-coloured stat value (blue). IBM Plex Sans."
        },
        "body": {
          "body":         "Default body copy, primary text. Bricolage 16px/400w, line-height 1.55.",
          "body-lg":      "Large body copy for loading-state primary text / empty-state headings. Bricolage 18px/500w.",
          "body-sm":      "Secondary copy, muted. Bricolage 14px/400w, neutral-600 / dark:neutral-400.",
          "label":        "Eyebrow / table column header. Bricolage 12px/600w uppercase, tracking 0.05em.",
          "field-label":  "Form-field label, non-uppercase. Bricolage 14px/500w, neutral-700 / dark:neutral-200. Pairs with form inputs.",
          "overline":     "Section eyebrow / pre-title. Bricolage 10px/600w uppercase, tracking 0.18em.",
          "label-cased":  "Microlabel, non-uppercase. Bricolage 10px/500w, neutral-500 / dark:neutral-400. For badge counts and micro-meta where uppercase wouldn't fit.",
          "caption":      "Supporting text under inputs / chart axes / footnotes. Bricolage 12px/400w.",
          "code":         "Inline code / numeric reference. JetBrains Mono 13px/500w, tabular-nums.",
          "code-display": "Identifier as visual hero (VIBANs, IBANs as panel headline). JetBrains Mono 18px/600w, tracking 0.025em."
        }
      }
    }
  },

