  "borderRadius": {
    "_description": "Phase 3 Design System Unification (v2.1.0): collapsed from 8 radii (sm/default/md/lg/xl/2xl/full + none) to 4 canonical values. variables.css mirrors this. The `xl` (16px) and `2xl` (24px) tokens are gone — cards uniformly read as 12px regardless of authoring style. Tailwind's `rounded-xl` and `rounded-2xl` utility classes are aliased to `lg` (12px) so existing callers keep working.",
    "none": { "value": "0",       "description": "No radius — niche use" },
    "sm":   { "value": "0.25rem", "description": "4px — badges, pills, chips" },
    "md":   { "value": "0.5rem",  "description": "8px — buttons, inputs, dropdowns" },
    "lg":   { "value": "0.75rem", "description": "12px — cards, modals, popovers" },
    "full": { "value": "9999px",  "description": "Fully rounded — pills, avatars, circles" }
  },

  "borderWidth": {
    "none":    { "value": "0",   "description": "No border" },
    "default": { "value": "1px", "description": "Default border" },
    "2":       { "value": "2px", "description": "Thick border — focus ring, active nav rule, outline buttons" }
  },

  "shadow": {
    "_description": "Phase 3 Design System Unification (v2.1.0): collapsed from 14 sprawling tokens to 4 canonical depth tokens (rest/hover/popover/modal) + a focus ring + 4 semantic state rings. variables.css mirrors this and keeps the old names alive as aliases so existing callers stay green.",
    "none": { "value": "none", "description": "No shadow" },
    "rest": {
      "value": "0 1px 3px rgba(16, 42, 67, 0.06), 0 1px 2px rgba(16, 42, 67, 0.04)",
      "description": "Base depth on a surface at rest — cards, inputs"
    },
    "hover": {
      "value": "0 4px 6px -1px rgba(16, 42, 67, 0.07), 0 2px 4px -1px rgba(16, 42, 67, 0.04)",
      "description": "Elevated state — card hover, primary buttons"
    },
    "popover": {
      "value": "0 10px 15px -3px rgba(16, 42, 67, 0.08), 0 4px 6px -2px rgba(16, 42, 67, 0.04)",
      "description": "Floating UI off the page plane — tooltips, dropdowns"
    },
    "modal": {
      "value": "0 25px 50px -12px rgba(16, 42, 67, 0.20)",
      "description": "Modal dialog drop-shadow — deepest depth"
    },
    "inner": {
      "value": "inset 0 2px 4px 0 rgba(16, 42, 67, 0.04)",
      "description": "Inner shadow — input field depth, pressed states"
    },
    "focus": {
      "value": "0 0 0 2px {color.semantic.brand.accent}, 0 0 0 4px {color.semantic.background.primary}",
      "description": "Canonical focus ring — gold on every focusable element"
    },
    "ringAccent": {
      "value": "0 0 0 3px rgba(245, 158, 11, 0.15)",
      "description": "Gold accent state halo (semantic state ring, not a depth shadow)"
    },
    "ringPrimary": {
      "value": "0 0 0 3px rgba(16, 42, 67, 0.10)",
      "description": "Navy primary state halo"
    },
    "ringSuccess": {
      "value": "0 0 0 3px rgba(16, 185, 129, 0.15)",
      "description": "Green success state halo — form validation success"
    },
    "ringError": {
      "value": "0 0 0 3px rgba(247, 115, 22, 0.18)",
      "description": "Orange error state halo — form validation error (Phase 2: tuned to match new warning hue)"
    }
  },

