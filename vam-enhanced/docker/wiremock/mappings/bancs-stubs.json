    {
      "name": "BaNCS Error - Invalid Account",
      "request": {
        "method": "POST",
        "url": "/bancs-stub/api/v1/account/balance",
        "bodyPatterns": [
          {
            "contains": "INVALID"
          }
        ]
      },
      "response": {
        "status": 400,
        "headers": {
          "Content-Type": "application/json"
        },
        "jsonBody": {
          "responseCode": "E001",
          "responseMessage": "Invalid Account Number",
          "errorDetails": "The specified account does not exist"
        }
      }
    }
