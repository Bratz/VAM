            "availableBalance": 15250000.00,
            "status": "ACTIVE"
          }
        }
      }
    },
    {
      "name": "BaNCS Fund Transfer",
      "request": {
        "method": "POST",
        "url": "/bancs-stub/api/v1/transfer/execute"
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "application/json"
        },
        "jsonBody": {
          "responseCode": "00",
          "responseMessage": "Transfer Successful",
          "transactionRef": "BANCS-{{randomValue length=10 type='ALPHANUMERIC'}}",
          "status": "COMPLETED",
          "timestamp": "{{now}}"
        }
      }
    },
    {
      "name": "BaNCS Transaction History",
      "request": {
        "method": "POST",
        "url": "/bancs-stub/api/v1/account/transactions"
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "application/json"
        },
        "jsonBody": {
          "responseCode": "00",
          "responseMessage": "Success",
          "transactions": [
            {
              "transactionId": "TXN001",
              "date": "2024-01-15",
              "type": "CREDIT",
              "amount": 50000.00,
              "currency": "AED",
              "description": "Customer Payment",
              "reference": "INV-2024-001"
            },
            {
              "transactionId": "TXN002",
              "date": "2024-01-14",
              "type": "DEBIT",
              "amount": 25000.00,
              "currency": "AED",
              "description": "Supplier Payment",
              "reference": "PO-2024-001"
            }
          ],
          "pagination": {
            "page": 1,
            "pageSize": 10,
            "totalRecords": 2,
            "totalPages": 1
          }
        }
      }
    },
    {
