{
  "mappings": [
    {
      "name": "BaNCS Health Check",
      "request": {
        "method": "GET",
        "url": "/bancs-stub/health"
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "application/json"
        },
        "jsonBody": {
          "status": "UP",
          "service": "BaNCS Stub",
          "timestamp": "{{now}}"
        }
      }
    },
    {
      "name": "BaNCS Customer Inquiry",
      "request": {
        "method": "POST",
        "url": "/bancs-stub/api/v1/customer/inquiry"
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "application/json"
        },
        "jsonBody": {
          "responseCode": "00",
          "responseMessage": "Success",
          "customer": {
            "customerId": "BANCS-CUST-001",
            "customerName": "Desert Oasis E-Commerce LLC",
            "customerType": "CORPORATE",
            "status": "ACTIVE",
            "kycStatus": "VERIFIED"
          }
        }
      }
    },
    {
      "name": "BaNCS Account Balance",
      "request": {
        "method": "POST",
        "url": "/bancs-stub/api/v1/account/balance"
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "application/json"
        },
        "jsonBody": {
          "responseCode": "00",
          "responseMessage": "Success",
          "account": {
            "accountNumber": "0011234567890",
            "accountName": "Desert Oasis Main Operating",
            "currency": "AED",
