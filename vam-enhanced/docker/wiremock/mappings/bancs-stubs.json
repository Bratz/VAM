      "request": {
        "method": "POST",
        "url": "/bancs-stub/api/v1/account/statement"
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "application/json"
        },
        "jsonBody": {
          "responseCode": "00",
