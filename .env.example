# ==========================================
# VAM Portal - Environment Configuration
# ==========================================
# Copy this file to .env and modify as needed
# ==========================================

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=vam_db
DB_USER=vam_user
DB_PASSWORD=vam_secure_password_123

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# Backend Configuration
BACKEND_PORT=8080
JWT_SECRET=your-super-secret-jwt-key-change-in-production-make-it-very-long-at-least-256-bits

# Frontend Configuration
FRONTEND_PORT=3000
VITE_API_BASE_URL=/api

# BaNCS Integration
BANCS_API_URL=http://localhost:8090/bancs-stub
BANCS_CLIENT_ID=vam-client
BANCS_CLIENT_SECRET=vam-secret
BANCS_SYNC_ENABLED=false

# Optional Services
ADMINER_PORT=8081
BANCS_PORT=8090

# Logging
LOG_LEVEL=INFO
